# Copy this file to .env and fill it in. Never commit .env.
#
# One file holds every setting that differs between installations: the daemon
# reads the first section, deploy.sh and sync.sh the second, sync.sh and
# info-triage-capture the third. deploy.sh copies it to the server as it is.
# A value set in the real environment overrides the one here.

# --- The daemon -------------------------------------------------------------

# Bearer token required by POST /capture and GET /routes: the browser extension
# and the command-line client send it. Generate with: openssl rand -base64 32
INFO_TRIAGE_CAPTURE_TOKEN=a-long-random-string

# Telegram, optional. One bot token per route that declares a `token_env` in
# config.yaml. Each is a separate bot from BotFather; two routes sharing a token
# means two pollers on one bot, which the daemon refuses.
# TELEGRAM_BOT_TOKEN_INFO=123456:your-token
# TELEGRAM_BOT_TOKEN_JOB=123456:your-token
# TELEGRAM_BOT_TOKEN_CLIP=123456:your-token

# The one Telegram user the bots answer to: your numeric id, which @userinfobot
# tells you. Needed as soon as one route has a bot.
# ALLOWED_USER_ID=123456789

# The user and group the container runs as: whoever owns ./data on the machine
# that runs it (`id -u` and `id -g` there). A Synology's first user is 1026:100.
INFO_TRIAGE_UID=1000
INFO_TRIAGE_GID=1000

# The container's timezone.
TZ=UTC

# Optional: use a configuration file other than ./config.yaml.
# INFO_TRIAGE_CONFIG=/absolute/path/to/config.yaml

# --- Where the server is (deploy.sh, sync.sh) ----------------------------------

# How SSH reaches the machine that runs the daemon: an alias from ~/.ssh/config,
# or user@host. Leave it empty when the daemon runs on this machine.
INFO_TRIAGE_SERVER=

# The project directory on that machine, as an absolute path. Its data/ holds
# everything captured. Not needed when INFO_TRIAGE_SERVER is empty.
INFO_TRIAGE_SERVER_DIR=

# Optional: what rebuilds and restarts the container there. The default is
# `docker compose up -d --build` in the project directory.
# INFO_TRIAGE_DEPLOY_COMMAND=sudo -n /usr/local/sbin/deploy-container info-triage

# --- This machine (sync.sh, info-triage-capture) --------------------------------

# Where sync.sh puts the inbox. Default: ~/info-triage-inbox
# INFO_TRIAGE_INBOX=~/info-triage-inbox

# Where info-triage-capture reaches the daemon. Default: http://localhost:8000
# INFO_TRIAGE_CAPTURE_URL=http://my-server:8000

# Optional: point each item at the notes it probably belongs with. Needs both
# directories and `uv sync --extra neighbours`; left unset, the pass is off.
# INFO_TRIAGE_ORG_ROOT=~/notes/org
# INFO_TRIAGE_OBSIDIAN_ROOT=~/notes/vault
# Org file names never searched, comma-separated. Default: workspace.org,init.org
# INFO_TRIAGE_ORG_EXCLUDE=workspace.org,init.org,Inbox.org
# The one route whose items are annotated. Default: info
# INFO_TRIAGE_NEIGHBOUR_ROUTE=info
