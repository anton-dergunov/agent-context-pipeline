# Copy this file to .env and replace every value. Never commit .env.

# One bot token per route. Each is a separate bot from BotFather; two routes
# sharing a token means two pollers on one bot, which the daemon refuses.
TELEGRAM_BOT_TOKEN_INFO=your-token
TELEGRAM_BOT_TOKEN_JOB=your-token
TELEGRAM_BOT_TOKEN_CLIP=your-token
TELEGRAM_BOT_TOKEN_LANG=your-token

# One user, all four bots.
ALLOWED_USER_ID=your-numeric-telegram-user-id

# Bearer token required by POST /capture. Generate with: openssl rand -base64 32
INFO_TRIAGE_CAPTURE_TOKEN=a-long-random-string

# Optional: override the default ./config.yaml location.
# INFO_TRIAGE_CONFIG=/absolute/path/to/config.yaml
